<Window x:Class="TaskSum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:TaskSum.Converters"
        xmlns:vm="clr-namespace:TaskSum.ViewModels"
        mc:Ignorable="d"
        Title="TaskSum - Azure DevOps 工数集計"
        Height="820" Width="1280"
        FontSize="13"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:ExpandedToArrowConverter x:Key="ExpandArrow" />
        <conv:LevelToIndentConverter x:Key="LevelIndent" />
        <conv:DoubleFormatConverter x:Key="DblFmt" />
        <conv:WorkItemTypeColorConverter x:Key="TypeColor" />
        <conv:ThresholdToBackgroundConverter x:Key="ThresholdBg" />
        <conv:BindingProxy x:Key="VMProxy" Data="{Binding}" />

        <!-- 読み込みボタンスタイル -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAAAAA" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- サブボタンスタイル -->
        <Style x:Key="SubButton" TargetType="Button">
            <Setter Property="BorderBrush" Value="#BBBBBB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 展開ボタンスタイル -->
        <Style x:Key="ExpandButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- ListView アイテムスタイル -->
        <Style x:Key="TreeListViewItem" TargetType="ListViewItem">
            <EventSetter Event="ContextMenuOpening" Handler="OnListViewItemContextMenuOpening" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Webで開く"
                                  Command="{Binding Data.OpenInBrowserCommand, Source={StaticResource VMProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="#FFF3CC" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4FF" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F4FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- フィルタドロップダウンスタイル -->
        <Style x:Key="FilterDropdown" TargetType="ToggleButton">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Content}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="▾"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#666666" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 合計行スタイル -->
        <Style x:Key="AggGridRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="#D6EAD6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 設定バー -->
            <RowDefinition Height="Auto" />
            <!-- フィルタバー -->
            <RowDefinition Height="Auto" />
            <!-- TreeListView -->
            <RowDefinition Height="*" MinHeight="60" />
            <!-- GridSplitter -->
            <RowDefinition Height="5" />
            <!-- 集計パネル -->
            <RowDefinition Height="200" MinHeight="60" />
            <!-- ステータスバー -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================
             Row 0: 設定バー
             ======================================== -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10,7"
                BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Organization URL:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding OrganizationUrl, UpdateSourceTrigger=PropertyChanged}"
                         Width="300" Margin="0,0,14,0" Padding="5,3"
                         VerticalContentAlignment="Center"
                         ToolTip="例: https://dev.azure.com/myorg" />

                <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"
                         Width="160" Margin="0,0,14,0" Padding="5,3"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="PAT Key:" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="環境変数名 / Windows 資格情報マネージャーの資格情報名 (既定: ADO_PAT)&#x0a;環境変数を優先し、見つからない場合は資格情報マネージャーを参照します。" />
                <TextBox Text="{Binding CredentialName, UpdateSourceTrigger=PropertyChanged}"
                         Width="120" Margin="0,0,14,0" Padding="5,3"
                         VerticalContentAlignment="Center"
                         ToolTip="環境変数名 / Windows 資格情報マネージャーの資格情報名 (既定: ADO_PAT)&#x0a;環境変数を優先し、見つからない場合は資格情報マネージャーを参照します。" />

                <TextBlock Text="Feature ID:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding FeatureId, UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Margin="0,0,10,0" Padding="5,3"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LoadCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="読み込み" Command="{Binding LoadCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />

                <ProgressBar IsIndeterminate="True" Width="90" Height="14"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ========================================
             Row 1: フィルタバー
             ======================================== -->
        <Border Grid.Row="1" Background="#FAFAFA" Padding="10,5"
                BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="フィルタ:" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <!-- 担当者フィルタ -->
                <TextBlock Text="担当者:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Grid Margin="0,0,16,0">
                    <ToggleButton x:Name="BtnAssignedTo"
                                  Content="{Binding AssignedToDisplayText}"
                                  IsChecked="{Binding IsAssignedToOpen, Mode=TwoWay}"
                                  Style="{StaticResource FilterDropdown}"
                                  Width="180" />
                    <Popup IsOpen="{Binding IsAssignedToOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BtnAssignedTo}"
                           Placement="Bottom"
                           StaysOpen="False"
                           MinWidth="{Binding ActualWidth, ElementName=BtnAssignedTo}">
                        <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding AssignedToOptions}"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Padding="4,2" Margin="4,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 状態フィルタ -->
                <TextBlock Text="状態:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Grid Margin="0,0,20,0">
                    <ToggleButton x:Name="BtnState"
                                  Content="{Binding StateDisplayText}"
                                  IsChecked="{Binding IsStateOpen, Mode=TwoWay}"
                                  Style="{StaticResource FilterDropdown}"
                                  Width="150" />
                    <Popup IsOpen="{Binding IsStateOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BtnState}"
                           Placement="Bottom"
                           StaysOpen="False"
                           MinWidth="{Binding ActualWidth, ElementName=BtnState}">
                        <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding StateOptions}"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Padding="4,2" Margin="4,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <!-- IsReview フィルタ -->
                <TextBlock Text="IsReview:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Grid Margin="0,0,16,0">
                    <ToggleButton x:Name="BtnIsReview"
                                  Content="{Binding IsReviewDisplayText}"
                                  IsChecked="{Binding IsIsReviewOpen, Mode=TwoWay}"
                                  Style="{StaticResource FilterDropdown}"
                                  Width="110" />
                    <Popup IsOpen="{Binding IsIsReviewOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BtnIsReview}"
                           Placement="Bottom"
                           StaysOpen="False"
                           MinWidth="{Binding ActualWidth, ElementName=BtnIsReview}">
                        <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White">
                            <ItemsControl ItemsSource="{Binding IsReviewOptions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked}"
                                                  Padding="4,2" Margin="4,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>

                <!-- DevelopProcess フィルタ -->
                <TextBlock Text="Dev.Process:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Grid Margin="0,0,20,0">
                    <ToggleButton x:Name="BtnDevelopProcess"
                                  Content="{Binding DevelopProcessDisplayText}"
                                  IsChecked="{Binding IsDevelopProcessOpen, Mode=TwoWay}"
                                  Style="{StaticResource FilterDropdown}"
                                  Width="150" />
                    <Popup IsOpen="{Binding IsDevelopProcessOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=BtnDevelopProcess}"
                           Placement="Bottom"
                           StaysOpen="False"
                           MinWidth="{Binding ActualWidth, ElementName=BtnDevelopProcess}">
                        <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding DevelopProcessOptions}"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Padding="4,2" Margin="4,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="すべて展開" Command="{Binding ExpandAllCommand}"
                        Style="{StaticResource SubButton}" Margin="0,0,6,0" />
                <Button Content="すべて折り畳む" Command="{Binding CollapseAllCommand}"
                        Style="{StaticResource SubButton}" Margin="0,0,16,0" />
                <Button Content="フィルタ全解除" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SubButton}" />
            </StackPanel>
        </Border>

        <!-- ========================================
             Row 2: TreeListView
             ======================================== -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding VisibleNodes}"
                  ItemContainerStyle="{StaticResource TreeListViewItem}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  BorderThickness="0">
            <ListView.View>
                <GridView>

                    <!-- 集計絞り込みチェックボックス -->
                    <GridViewColumn Header="集計" Width="42">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="チェックした項目とその子のみ集計" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- ID -->
                    <GridViewColumn Header="ID" Width="65">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 種別 -->
                    <GridViewColumn Header="種別" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Padding="4,1"
                                        Background="{Binding WorkItemType, Converter={StaticResource TypeColor}}">
                                    <TextBlock Text="{Binding WorkItemType}"
                                               Foreground="White"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- タイトル (ツリーインデント付き) -->
                    <GridViewColumn Header="タイトル" Width="420">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="{Binding Level, Converter={StaticResource LevelIndent}}"
                                            VerticalAlignment="Center">
                                    <!-- 展開ボタン (子あり) -->
                                    <Button Content="{Binding IsExpanded, Converter={StaticResource ExpandArrow}}"
                                            Style="{StaticResource ExpandButton}"
                                            Command="{Binding DataContext.ToggleExpandCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,3,0" />
                                    <!-- スペーサー (子なし) -->
                                    <Border Width="21" Height="1"
                                            Visibility="{Binding HasChildren, Converter={StaticResource InvBoolToVis}}" />
                                    <!-- タイトル -->
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 状態 -->
                    <GridViewColumn Header="状態" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 担当者 -->
                    <GridViewColumn Header="担当者" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AssignedTo}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AssignedTo}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- IsReview -->
                    <GridViewColumn Header="IsReview" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReview}" Value="True">
                                                    <Setter Property="Text" Value="✓" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Dev Process -->
                    <GridViewColumn Header="Dev Process" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DevelopProcess}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DevelopProcess}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 見積 -->
                    <GridViewColumn Header="見積 (h)" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OriginalEstimate, Converter={StaticResource DblFmt}}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 残余 -->
                    <GridViewColumn Header="残余 (h)" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemainingWork, Converter={StaticResource DblFmt}}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- 完了 -->
                    <GridViewColumn Header="完了 (h)" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CompletedWork, Converter={StaticResource ThresholdBg}}"
                                        HorizontalAlignment="Stretch" Padding="0,1">
                                    <TextBlock Text="{Binding CompletedWork, Converter={StaticResource DblFmt}}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

        <!-- ========================================
             Row 3: GridSplitter
             ======================================== -->
        <GridSplitter Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#D0D0D0"
                      ResizeDirection="Rows" />

        <!-- ========================================
             Row 4: 集計パネル
             ======================================== -->
        <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 集計ヘッダー -->
                <Border Grid.Row="0" Background="#EBEBEB" Padding="10,4"
                        BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="集計 (Dev Process 別)"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <!-- 列設定ドロップダウン -->
                        <Grid Grid.Column="1">
                            <ToggleButton x:Name="BtnAggColumns"
                                          Content="列設定"
                                          IsChecked="{Binding IsAggColumnsOpen, Mode=TwoWay}"
                                          Style="{StaticResource FilterDropdown}"
                                          Width="90" />
                            <Popup IsOpen="{Binding IsAggColumnsOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=BtnAggColumns}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   MinWidth="{Binding ActualWidth, ElementName=BtnAggColumns}">
                                <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White">
                                    <ItemsControl ItemsSource="{Binding AggColumnOptions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsChecked}"
                                                          Padding="4,2" Margin="4,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 集計テーブル -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding AggregationItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          RowStyle="{StaticResource AggGridRow}"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Dev Process: 固定・非表示不可 -->
                        <DataGridTextColumn Header="Dev Process"
                                            Binding="{Binding Activity}"
                                            Width="200" />

                        <!-- 件数 -->
                        <DataGridTextColumn Header="件数"
                                            Binding="{Binding Count}"
                                            Width="55"
                                            Visibility="{Binding Data.ColCountVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 見積(作業時間) -->
                        <DataGridTextColumn Header="見積(作業時間) (h)"
                                            Binding="{Binding NonReviewOriginalEstimate, StringFormat='0.##'}"
                                            Width="130"
                                            Visibility="{Binding Data.ColEstNonReviewVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 見積(レビュー) -->
                        <DataGridTextColumn Header="見積(レビュー) (h)"
                                            Binding="{Binding ReviewOriginalEstimate, StringFormat='0.##'}"
                                            Width="120"
                                            Visibility="{Binding Data.ColEstReviewVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 見積(全体) -->
                        <DataGridTextColumn Header="見積(全体) (h)"
                                            Binding="{Binding TotalOriginalEstimate, StringFormat='0.##'}"
                                            Width="105"
                                            Visibility="{Binding Data.ColEstAllVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 残余(作業時間) -->
                        <DataGridTextColumn Header="残余(作業時間) (h)"
                                            Binding="{Binding NonReviewRemainingWork, StringFormat='0.##'}"
                                            Width="130"
                                            Visibility="{Binding Data.ColRemNonReviewVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 残余(レビュー) -->
                        <DataGridTextColumn Header="残余(レビュー) (h)"
                                            Binding="{Binding ReviewRemainingWork, StringFormat='0.##'}"
                                            Width="120"
                                            Visibility="{Binding Data.ColRemReviewVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 残余(全体) -->
                        <DataGridTextColumn Header="残余(全体) (h)"
                                            Binding="{Binding TotalRemainingWork, StringFormat='0.##'}"
                                            Width="105"
                                            Visibility="{Binding Data.ColRemAllVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 完了(作業時間) -->
                        <DataGridTextColumn Header="完了(作業時間) (h)"
                                            Binding="{Binding NonReviewCompletedWork, StringFormat='0.##'}"
                                            Width="130"
                                            Visibility="{Binding Data.ColCmpNonReviewVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 完了(レビュー) -->
                        <DataGridTextColumn Header="完了(レビュー) (h)"
                                            Binding="{Binding ReviewCompletedWork, StringFormat='0.##'}"
                                            Width="120"
                                            Visibility="{Binding Data.ColCmpReviewVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 完了(全体) -->
                        <DataGridTextColumn Header="完了(全体) (h)"
                                            Binding="{Binding TotalCompletedWork, StringFormat='0.##'}"
                                            Width="105"
                                            Visibility="{Binding Data.ColCmpAllVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 完了レビュー率 -->
                        <DataGridTextColumn Header="完了レビュー率"
                                            Binding="{Binding ReviewCompletedRatio, StringFormat='{}{0:0.#}%'}"
                                            Width="100"
                                            Visibility="{Binding Data.ColCmpRatioVisibility, Source={StaticResource VMProxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================================
             Row 5: ステータスバー
             ======================================== -->
        <StatusBar Grid.Row="5" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Margin="4,0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
